<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Gyropad.Linux.MainWindow"
        Title="Gyropad"
        Width="600" Height="720"
        MinWidth="520" MinHeight="620"
        Background="#14171c"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1d222a"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="monospace"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <!-- Header: name, version, connection pill -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="Gyropad" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Classes="label"/>
      </StackPanel>
      <Border Grid.Column="1" CornerRadius="20" Padding="14,6"
              Background="#22303b" VerticalAlignment="Center">
        <TextBlock x:Name="PillText" Text="starting" FontSize="13"/>
      </Border>
    </Grid>

    <!-- Main content -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="12">

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock x:Name="StatusText" Classes="value" Text="Starting..."/>
            <TextBlock x:Name="DetailText" Classes="label" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="14" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="PHONE"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PhoneText" Classes="value" Text="-"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="ADDRESS"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AddressText" Classes="value" Text="-"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="INPUT"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PersonaText" Classes="value" Text="-"/>
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="VIRTUAL DEVICES" VerticalAlignment="Center"/>
              <Button Grid.Column="1" x:Name="DoctorButton" Content="Run doctor" FontSize="12" Padding="10,4"/>
            </Grid>
            <TextBlock x:Name="DeviceStatusText" Classes="value" Text="-"/>
            <TextBlock x:Name="DeviceDetailText" Classes="label" TextWrapping="Wrap" IsVisible="False"/>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="PHONES FOUND ON THIS NETWORK"/>
            <ListBox x:Name="DevicesList" Height="118" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="1" Margin="0,2">
                    <TextBlock Text="{Binding Pretty}" FontSize="14"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="PairButton" Content="Pair with selected phone" IsEnabled="False"/>
              <Button x:Name="UnpairButton" Content="Forget this phone"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="RECENT EVENTS"/>
            <ScrollViewer Height="110" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="LogText" Classes="mono" TextWrapping="Wrap"/>
            </ScrollViewer>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Margin="0,14,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="ConfigText" Classes="label" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Classes="label" Text="Gyropad 1.39 - Linux port"/>
      </Grid>
    </Border>

    <!-- Pairing approval overlay -->
    <Border x:Name="ApprovalOverlay" Grid.RowSpan="3" IsVisible="False"
            Background="#cc0d0f12">
      <Border Classes="card" MaxWidth="440" VerticalAlignment="Center"
              BorderBrush="#3a4552" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock x:Name="ApprovalTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="ApprovalBody" Classes="value" Opacity="0.8"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="DenyButton" Content="Not now"/>
            <Button x:Name="ApproveButton" Content="Connect"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>
